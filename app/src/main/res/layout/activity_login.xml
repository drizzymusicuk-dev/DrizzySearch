<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="24dp"
    android:gravity="center" android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView android:text="Drizzy Search Login"
        android:textSize="22sp" android:layout_marginBottom="24dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <EditText android:id="@+id/username"
        android:hint="Username" android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <EditText android:id="@+id/password"
        android:hint="Password" android:inputType="textPassword"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <Button android:id="@+id/loginBtn" android:text="Login"
        android:layout_marginTop="16dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
